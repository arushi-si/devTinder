PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kodo
JWT_SECRET=<long-random-string>
# comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
# cookie sameSite: "lax" (default) when the FE proxies /api to this server
COOKIE_SAMESITE=lax
# number of proxies in front of the app in production (Vercel rewrite + Render = 2)
TRUST_PROXY=
# Photo uploads (free account at cloudinary.com -> Dashboard -> API Keys). Uploads are disabled if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: fixed password for seeded demo accounts (npm run seed). Unset = random, unusable.
DEMO_PASSWORD=
